# Copy to chatbot-service/.env (gitignored). Never commit real values.

# Firebase service account JSON (Firebase console > Project settings > Service accounts).
# Keep the file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=E:\secrets\datanaut-sa.json
# Optional; read from the service account when empty
FIREBASE_PROJECT_ID=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Where full datasets are stored as Parquet (relative to chatbot-service/)
DATA_DIR=data
MAX_UPLOAD_MB=50
