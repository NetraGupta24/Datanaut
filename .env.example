# Copy to .env and fill in. Only VITE_* variables are exposed to the browser.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These are public client identifiers; firestore.rules is what protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# DATANAUT data service (chatbot-service, FastAPI). It also runs the chatbot,
# so no AI keys belong in this file: they stay in chatbot-service/.env.
VITE_API_URL=http://localhost:8000

# Set to "true" to run without Firebase: any email/password logs in, data stays in localStorage
VITE_DEMO_MODE=false
